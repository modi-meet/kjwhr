# Day-ahead auction gate closure, UTC, applied on the decision day (D-1). Strict "<" comparison.
CUTOFF_TIME=09:50
# Decision-day window (purchase decisions made in January 2026)
DECISION_FROM=2026-01-01
DECISION_TO=2026-01-31
# Where the committed Elexon snapshot lives (relative to repo root or absolute)
SNAPSHOT_DIR=backend/app/snapshot
